{
  "name": "lightning-pool",
  "private": true,
  "description": "Fastest generic Pool written with TypeScript",
  "version": "4.14.1",
  "author": "Panates",
  "license": "MIT",
  "dependencies": {
    "doublylinked": "^2.5.6",
    "putil-promisify": "^1.10.1",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@panates/eslint-config": "^2.3.5",
    "@panates/eslint-config-ts": "^2.3.5",
    "@panates/rman-preset": "^2.2.2",
    "@panates/tsconfig": "^2.1.8",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "expect": "^30.5.2",
    "generic-pool": "^3.9.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "npm-run-path": "^6.0.0",
    "tinybench": "^6.2.3",
    "typescript": "^6.0.3",
    "yargs": "^18.2.0"
  },
  "scripts": {
    "test": "mocha",
    "citest": "c8 mocha",
    "precitest": "rman clean",
    "lint": "rman lint",
    "check": "rman check",
    "format": "rman format",
    "bench": "node --import ./benchmark/env.mjs --import @swc-node/register/esm-register benchmark/cli.ts",
    "bench:report": "node --import ./benchmark/env.mjs --import @swc-node/register/esm-register benchmark/report/render-markdown.ts",
    "graph": "graphify update ."
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/lightning-pool.git"
  },
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "keywords": [
    "pool",
    "generic",
    "generic-pool"
  ],
  "publishConfig": {
    "access": "public"
  }
}
